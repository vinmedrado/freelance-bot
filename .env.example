GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Modo padrao: conecta no Chrome que voce ja abre com --remote-debugging-port.
# So precisa mudar se a porta nao for a padrao (9222).
CHROME_CDP_URL=http://127.0.0.1:9222

# Usados pelo dashboard.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=5050

# So usados se voce trocar para mode="real_profile" no codigo (fallback,
# exige Chrome fechado ao rodar):
# CHROME_USER_DATA_DIR=C:\chrome-ml
# CHROME_PROFILE_NAME=Default
